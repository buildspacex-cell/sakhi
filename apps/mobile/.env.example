# Mobile App Environment Variables
# Copy this to .env.local and fill in your values

# FastAPI Backend URL
# For local development, use your computer's IP address (not localhost)
# because the phone/simulator can't reach localhost on your dev machine
# Example: http://192.168.1.100:8080
EXPO_PUBLIC_BACKEND_URL=http://YOUR_IP:8080

# Optional (development only): bypass mobile login and force a specific person_id.
# Use this for end-to-end simulation profile testing in iOS simulator.
# Leave empty/omit for normal auth flow.
EXPO_PUBLIC_DEV_BYPASS_PERSON_ID=

# Optional (release/internal TestFlight only): enable fixed-profile bypass in
# dedicated testflight* build profiles. Keep disabled for normal production.
EXPO_PUBLIC_RELEASE_BYPASS_ENABLED=0
EXPO_PUBLIC_RELEASE_BYPASS_PERSON_ID=

# OpenAI API Key for voice features (STT/TTS)
# Get one at https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
